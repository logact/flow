# Server-side learning state backend: memory (default) or sqlite
FLOW_STORAGE=memory
# SQLite database location; defaults to .data/flow.sqlite when FLOW_STORAGE=sqlite
# FLOW_SQLITE_PATH=.data/flow.sqlite

# Email login. Generate FLOW_AUTH_SECRET with: openssl rand -hex 32
FLOW_AUTH_SECRET=
# QQ Mail SMTP (enable SMTP and use its authorization code, not the mailbox password)
QQ_SMTP_HOST=smtp.qq.com
QQ_SMTP_PORT=465
QQ_SMTP_USER=
QQ_SMTP_AUTH_CODE=
# Optional; defaults to QQ_SMTP_USER
# QQ_SMTP_FROM=
