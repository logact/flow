{
  "name": "flow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "dev:manual-test": "FLOW_MANUAL_TEST_MODE=1 next dev --hostname 0.0.0.0 -p 3101",
    "build": "next build",
    "start": "next start",
    "test": "jest --runInBand",
    "test:p2": "jest --runInBand test/schedule.jest.test.ts",
    "test:p3": "jest --runInBand test/vocabulary.jest.test.ts test/vocabulary-reference.jest.test.ts test/vocabulary-capacity-test.jest.test.ts test/scoring.jest.test.ts",
    "test:p4": "jest --runInBand test/capacity.jest.test.ts",
    "test:p5": "jest --runInBand test/task-assignment.jest.test.ts",
    "test:p6": "jest --runInBand test/task-material.jest.test.ts",
    "test:p6:live": "jest --runInBand --testMatch '**/test/task-material.live.test.ts'",
    "logs:p6:prompt": "node scripts/show-task-generation-prompt.cjs",
    "test:p7": "jest --runInBand test/task-grading.jest.test.ts",
    "test:p7:live": "jest --runInBand --testMatch '**/test/task-grading.live.test.ts'",
    "logs:p7": "node scripts/show-task-grading.cjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.4",
    "pdfjs-dist": "^6.5.438",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "wink-lemmatizer": "^3.0.4"
  },
  "devDependencies": {
    "@swc/jest": "^0.2.39",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jest": "^30.5.2",
    "pdfkit": "^0.20.2",
    "typescript": "^7.0.2"
  }
}
